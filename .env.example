# Provider selected by default when pressing Enter at startup: lmstudio or ollama
LLM_PROVIDER=ollama

# Optional overrides. Defaults are selected from LLM_PROVIDER:
#   lmstudio: http://localhost:1234/v1, API key lm-studio
#   ollama:   http://localhost:11434/v1, API key ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# Optional. If omitted or unavailable, the first model returned by the server is used.
LLM_MODEL=qwen3:8b

# Optional workspace suggested at startup. Relative paths use the launch directory.
# LAMACODE_WORKSPACE=../my-project

# Token budget. Input is limited to context size minus reserved output tokens.
# LLM_CONTEXT_SIZE=8192
# LLM_MAX_OUTPUT_TOKENS=1024
